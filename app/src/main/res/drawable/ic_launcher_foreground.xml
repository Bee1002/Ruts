<?xml version="1.0" encoding="utf-8"?>
<!-- Ruts Go! mark, adapted from SVG concept for adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Center 100x100 artwork inside 108x108, slightly inset for circular masks. -->
    <group
        android:translateX="10"
        android:translateY="10"
        android:scaleX="0.88"
        android:scaleY="0.88">

        <!-- Speed trails -->
        <path
            android:pathData="M15,35 L45,35"
            android:strokeWidth="6"
            android:strokeColor="#8A8D91"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M25,50 L35,50"
            android:strokeWidth="6"
            android:strokeColor="#8A8D91"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!-- Main symbol (route arrow / abstract R) -->
        <path
            android:pathData="M35,75 L35,25 L75,45 L50,55 L70,75"
            android:strokeWidth="10"
            android:strokeColor="#FF8000"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />

        <!-- Location pin -->
        <path
            android:fillColor="#E0E0E0"
            android:pathData="M75,45 C75,45 85,35 85,25 C85,15 75,15 75,15 C65,15 65,25 65,25 Z" />
        <path
            android:fillColor="#121212"
            android:pathData="M75,22 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
    </group>
</vector>
